PORT=3500
PUBLIC_BASE_URL=<public-api-base-url>

BOT_API_KEY=<set-a-strong-api-key>

BC_ACCESS_MODE=both

SQL_SERVER=<sql-read-server-host>
SQL_PORT=1433
SQL_DATABASE=<database-name>
SQL_USER=<sql-read-user>
SQL_PASSWORD=<sql-read-password>
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_SCHEMA=dbo

# Optional: POST/import write target. Defaults to the read SQL settings when omitted.
SQL_WRITE_SERVER=<sql-write-server-host>
SQL_WRITE_PORT=1433
SQL_WRITE_DATABASE=<database-name>
SQL_WRITE_USER=<sql-write-user>
SQL_WRITE_PASSWORD=<sql-write-password>
SQL_WRITE_ENCRYPT=false
SQL_WRITE_TRUST_SERVER_CERTIFICATE=true
SQL_WRITE_SCHEMA=dbo

DEFAULT_COMPANY_CODE=FCL
BC_COMPANY_PREFIXES=CM=CM3,FCL=FCL1,FLM=FLM1,RMK=RMK

# Optional physical table overrides. Leave blank to auto-discover by company/name pattern.
# Overrides are safest for single-company diagnostics; company-prefixed overrides are ignored for other companies.
SQL_TABLE_IMPORTED_ORDERS=
SQL_TABLE_IMPORTED_SALES_AL=
SQL_TABLE_IMPORTED_RETURN_ORDERS=
SQL_TABLE_IMPORTED_CREDIT_NOTES_AL=
SQL_TABLE_CUSTOMER=
SQL_TABLE_CUSTOMER_EXT=
SQL_TABLE_ITEM=
SQL_TABLE_ITEM_EXT=
SQL_TABLE_SHIP_TO_ADDRESS=
SQL_TABLE_SHIP_TO_ADDRESS_EXT=
SQL_TABLE_SALESPERSON_PURCHASER=
SQL_TABLE_SALESPERSON_PURCHASER_EXT=
SQL_TABLE_CONTACT=
SQL_TABLE_DISTRICT_GROUP_CODE=
SQL_TABLE_SALES_HEADER=
SQL_TABLE_SALES_HEADER_EXT=
SQL_TABLE_SALES_INVOICE_HEADER=
SQL_TABLE_SALES_INVOICE_LINE=
SQL_TABLE_SALES_CR_MEMO_HEADER=

# Optional Business Central API-page import path.
BC_API_BASE_URL=<business-central-base-url>
BC_API_PUBLISHER=fcl
BC_API_GROUP=bot
BC_API_VERSION=v1.0
BC_API_COMPANY_IDS=CM=<company-guid>,FCL=<company-guid>,FLM=<company-guid>,RMK=<company-guid>
BC_API_USERNAME=<bc-user>
BC_API_PASSWORD=<bc-password-or-web-service-key>
BC_API_WEB_SERVICE_ACCESS_KEY=<web-service-access-key>
BC_API_BEARER_TOKEN=<access-token>
BC_API_TIMEOUT_MS=30000

# Keep these configurable because BC extension fields can live in app-suffixed SQL tables.
CUSTOMERS_WHERE=[Web Portal] = 1 AND [Blocked] = 0
ITEMS_WHERE=[PDA Item] = 1 AND [Blocked] = 0

DEFAULT_IMPORTED_ORDER_STATUS=0
IMPORT_DUPLICATE_RECHECK_DELAY_MS=5000
DEFAULT_LIMIT=100
MAX_LIMIT=1000
