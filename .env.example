PORT=3500
PUBLIC_BASE_URL=https://nav.farmerschoice.co.ke:8092

BOT_API_KEY=<set-a-strong-api-key>

SQL_SERVER=<live-sql-server-host-or-ip>
# Optional: import POST/write target. Defaults to SQL_SERVER when omitted.
# Set this to the test SQL server during testing, then to the live SQL server when POST imports are approved.
SQL_WRITE_SERVER=<write-sql-server-host-or-ip>
SQL_PORT=1433
SQL_DATABASE=<database-name>
SQL_USER=<sql-user>
SQL_PASSWORD=<sql-password>
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_SCHEMA=dbo

DEFAULT_COMPANY_CODE=FCL
BC_COMPANY_PREFIXES=CM=CM3,FCL=FCL1,FLM=FLM1,RMK=RMK

# Optional physical table overrides. Leave blank to auto-discover by company/name pattern.
SQL_TABLE_IMPORTED_ORDERS=
SQL_TABLE_IMPORTED_SALES_AL=
SQL_TABLE_CUSTOMER=
SQL_TABLE_ITEM=
SQL_TABLE_SHIP_TO_ADDRESS=
SQL_TABLE_SALESPERSON_PURCHASER=
SQL_TABLE_CONTACT=
SQL_TABLE_SALES_HEADER=
SQL_TABLE_SALES_INVOICE_HEADER=

# Keep these configurable because BC extension fields can live in app-suffixed SQL tables.
CUSTOMERS_WHERE=[Web Portal] = 1 AND [Blocked] = 0
ITEMS_WHERE=[PDA Item] = 1 AND [Blocked] = 0

DEFAULT_IMPORTED_ORDER_STATUS=0
IMPORT_DUPLICATE_RECHECK_DELAY_MS=5000
DEFAULT_LIMIT=100
MAX_LIMIT=1000
