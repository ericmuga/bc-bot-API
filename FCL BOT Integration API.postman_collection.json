              "query": [
                {
                  "key": "company",
                  "value": "{{company}}"
                }
              ]
            },
            "description": "Returns hard BC processing errors stamped on Imported Orders or Imported SalesAL lines for the selected external document number."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Imported document errors response is shaped', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.externalDocumentNo).to.eql(pm.collectionVariables.get('externalDocumentNo') || pm.variables.get('externalDocumentNo'));",
                  "  pm.expect(json.errorCount).to.be.a('number');",
                  "  pm.expect(json.errors).to.be.an('array');",
                  "});"
