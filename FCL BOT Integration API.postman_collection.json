    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Checks API and SQL connectivity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health check is OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().ok).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "API Readiness Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/status?company={{company}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "status"
              ],
              "query": [
                {
                  "key": "company",
                  "value": "{{company}}"
                }
              ]
            },
            "description": "Detailed readiness check. Confirms SQL connectivity, resolved Business Central SQL tables, and configured defaults."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API readiness is OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.ok).to.eql(true);",
                  "  pm.expect(json.database.server).to.not.include('172.');",
                  "  pm.expect(json.database.database).to.not.eql('FCL');",
                  "  pm.expect(json.tables.importedOrders).to.be.a('string');",
                  "  pm.expect(json.tables.customer).to.be.a('string');",
                  "  pm.expect(json.tables.item).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "BC Order Status by External Document No",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/status/{{externalDocumentNo}}?company={{company}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "status",
                "{{externalDocumentNo}}"
              ],
              "query": [
                {
                  "key": "company",
                  "value": "{{company}}"
                }
              ]
            },
            "description": "Primary BOT status check. Accepts the company query parameter and external document number, then returns current BC status from Sales Invoice Header, Sales Header, or Imported Orders."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('BC order status is returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.company).to.eql(pm.collectionVariables.get('company') || pm.variables.get('company'));",
                  "  pm.expect(json.documentType).to.eql('order');",
                  "  pm.expect(json.externalDocumentNo).to.eql(pm.collectionVariables.get('externalDocumentNo') || pm.variables.get('externalDocumentNo'));",
                  "  pm.expect(json.orderStatus).to.be.a('string');",
                  "  pm.expect(json.bcStage).to.be.oneOf(['Imported Orders', 'Imported SalesAL', 'Sales Header', 'Posted Sales Invoice']);",
                  "  pm.expect(json.sourceTable).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
