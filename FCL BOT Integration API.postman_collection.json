    {
      "name": "Imported Orders",
      "item": [
        {
          "name": "Create Imported Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"order\",\n  \"company\": \"{{company}}\",\n  \"externalDocumentNo\": \"{{externalDocumentNo}}\",\n  \"sellToCustomerNo\": \"{{customerNo}}\",\n  \"shipmentDate\": \"2026-06-22\",\n  \"salespersonCode\": \"{{salespersonCode}}\",\n  \"shipToCode\": \"NAIROBI\",\n  \"shipToName\": \"Nairobi Outlet\",\n  \"customerSpecification\": \"No onions\",\n  \"externalOrderUrl\": \"https://bot.example.com/orders/{{externalDocumentNo}}\",\n  \"lines\": [\n    {\n      \"lineNo\": 10000,\n      \"itemNo\": \"{{itemNo}}\",\n      \"quantity\": 12,\n      \"unitOfMeasure\": \"KG\",\n      \"productSpecification\": \"Vacuum packed\"\n    },\n    {\n      \"lineNo\": 20000,\n      \"itemNo\": \"{{itemNo}}\",\n      \"quantity\": 5,\n      \"unitOfMeasure\": \"KG\",\n      \"productSpecification\": \"Tray packed\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/imported-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imported-orders"
              ]
            },
            "description": "Stages a BOT order into BC Imported Orders. Before writing, the API checks staging, Sales Header, and Sales Invoice Header for the same External Document No.; if not found, it waits briefly and checks again to avoid duplicates during BC posting handover."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Imported order is staged', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.company).to.eql(pm.collectionVariables.get('company') || pm.variables.get('company'));",
                  "  pm.expect(json.externalDocumentNo).to.eql(pm.collectionVariables.get('externalDocumentNo') || pm.variables.get('externalDocumentNo'));",
                  "  pm.expect(json.lineCount).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Imported Invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"invoice\",\n  \"company\": \"{{company}}\",\n  \"externalDocumentNo\": \"BOT-INV-100045\",\n  \"sellToCustomerNo\": \"{{customerNo}}\",\n  \"shipmentDate\": \"2026-06-22\",\n  \"salespersonCode\": \"{{salespersonCode}}\",\n  \"shipToCode\": \"NAIROBI\",\n  \"shipToName\": \"Nairobi Outlet\",\n  \"location\": \"3535\",\n  \"totalHeaderAmount\": 1972,\n  \"totalHeaderQty\": 17,\n  \"billTo\": \"{{customerNo}}\",\n  \"cuInvoiceNo\": \"CU-100045\",\n  \"cuNo\": \"ETR-01\",\n  \"signingTime\": \"2026-06-22T10:15:00\",\n  \"lines\": [\n    {\n      \"lineNo\": 10000,\n      \"itemNo\": \"{{itemNo}}\",\n      \"quantity\": 12,\n      \"unitOfMeasure\": \"KG\",\n      \"unitPrice\": 116,\n      \"lineAmount\": 1392,\n      \"location\": \"3535\"\n    },\n    {\n      \"lineNo\": 20000,\n      \"itemNo\": \"{{itemNo}}\",\n      \"quantity\": 5,\n      \"unitOfMeasure\": \"KG\",\n      \"unitPrice\": 116,\n      \"lineAmount\": 580,\n      \"location\": \"3535\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/imported-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imported-orders"
              ]
            },
            "description": "Stages a BOT invoice into BC Imported SalesAL for the Import SalesAL posting process."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Imported invoice is staged', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.company).to.eql(pm.collectionVariables.get('company') || pm.variables.get('company'));",
                  "  pm.expect(json.documentType).to.eql('invoice');",
                  "  pm.expect(json.lineCount).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Imported Orders with Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imported-orders?company={{company}}&externalDocumentNo={{externalDocumentNo}}&customerNo={{customerNo}}&shipmentDate=2026-06-22&shipToCode=NAIROBI&salespersonCode={{salespersonCode}}&status=Order&limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imported-orders"
              ],
              "query": [
                {
                  "key": "company",
                  "value": "{{company}}"
                },
                {
                  "key": "externalDocumentNo",
                  "value": "{{externalDocumentNo}}"
                },
                {
                  "key": "customerNo",
                  "value": "{{customerNo}}"
                },
                {
                  "key": "shipmentDate",
                  "value": "2026-06-22"
                },
                {
                  "key": "shipmentDateFrom",
                  "value": "2026-06-01",
                  "disabled": true
                },
                {
                  "key": "shipmentDateTo",
                  "value": "2026-06-30",
                  "disabled": true
                },
                {
                  "key": "shipToCode",
                  "value": "NAIROBI"
                },
                {
                  "key": "salespersonCode",
                  "value": "{{salespersonCode}}"
                },
                {
                  "key": "status",
                  "value": "Order"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Lists Imported Orders lines with optional query filters: externalDocumentNo, customerNo/sellToCustomerNo, shipmentDate or shipmentDateFrom/shipmentDateTo, shipToCode, shipToName, salespersonCode, itemNo, company, status, limit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filtered imported orders are returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.company).to.eql(pm.collectionVariables.get('company') || pm.variables.get('company'));",
                  "  pm.expect(json.count).to.be.a('number');",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  if (json.data.length) {",
                  "    pm.expect(json.data[0]).to.have.property('externalDocumentNo');",
                  "    pm.expect(json.data[0]).to.have.property('statusName');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Imported Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imported-orders/{{externalDocumentNo}}?company={{company}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imported-orders",
                "{{externalDocumentNo}}"
              ],
              "query": [
                {
                  "key": "company",
                  "value": "{{company}}"
                }
              ]
            },
            "description": "Reads the staged imported order lines from BC Imported Orders by External Document No."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Imported order lines are returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.company).to.eql(pm.collectionVariables.get('company') || pm.variables.get('company'));",
                  "  pm.expect(json.lines).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(json.lines[0]).to.have.property('productSpecification');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Imported Order Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imported-orders/{{externalDocumentNo}}/status?company={{company}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imported-orders",
                "{{externalDocumentNo}}",
                "status"
              ],
              "query": [
                {
                  "key": "company",
                  "value": "{{company}}"
                }
              ]
            },
            "description": "Checks staged document status by line and also checks Sales Header / Sales Invoice Header. Status mapping: 0 Order, 1 Execute, 2 Post, 3 Cancelled, 4 Error. Imported Orders status Post means the live Sales Order exists; final posted state is confirmed from Sales Invoice Header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Imported order status is returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.externalDocumentNo).to.eql(pm.collectionVariables.get('externalDocumentNo') || pm.variables.get('externalDocumentNo'));",
                  "  pm.expect(json.state).to.be.oneOf(['imported', 'processing', 'salesOrder', 'posted', 'cancelled', 'error']);",
                  "  pm.expect(json.statusCounts).to.be.an('object');",
                  "  pm.expect(json.salesDocuments).to.be.an('object');",
                  "  pm.expect(json.lines).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Imported Document Errors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imported-orders/{{externalDocumentNo}}/errors?company={{company}}",
