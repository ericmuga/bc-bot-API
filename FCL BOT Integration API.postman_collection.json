{
  "info": {
    "_postman_id": "e41f9b8f-0ea1-4b4d-9f0a-1b858c7f2e90",
    "name": "FCL BOT Integration API",
    "description": "Postman collection for the FCL BOT Integration API. Orders are staged into Business Central Imported Orders; customers and items are read-only.",
