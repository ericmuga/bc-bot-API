              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customers response has nested ship-to array', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
